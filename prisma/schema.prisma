datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Stock {
  id          String   @id @default(uuid())
  category    String   // 'GREEN_BEAN' | 'BUBUK' | 'KEMASAN'
  name        String
  quantity    Float    
  minLimit    Float
  unit        String   // 'kg' | 'pcs'
  updatedAt   DateTime @updatedAt
}

model PriceHistory {
  id        String   @id @default(uuid())
  date      DateTime @unique
  price     Float    
  type      String   // 'GREEN_BEAN' | 'ROBUSTA' | 'ARABICA'
}

model SalesDemand {
  id        String   @id @default(uuid())
  date      DateTime @unique
  product   String   // 'KOPI_BUBUK_HALUS' | 'KOPI_BUBUK_KASAR'
  quantity  Float
}

model ProductionOrder {
  id          String   @id @default(uuid())
  orderNo     String   @unique
  product     String
  quantity    Float
  status      String   // 'PENDING' | 'PRODUCING' | 'COMPLETED'
  startDate   DateTime
  targetDate  DateTime
}

model SupplyChainPartner {
  id        String   @id @default(uuid())
  name      String   // Nama Petani / Supplier / Distributor
  role      String   // 'PETANI' | 'SUPPLIER' | 'DISTRIBUTOR'
  material  String   // 'Green Bean Robusta' | 'Packaging' | 'Kopi Bubuk'
  rating    Float
  contact   String
}

